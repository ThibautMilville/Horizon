{
  "private": true,
  "name": "@loft/horizon",
  "description": "Horizon - web application for managing a satellite company fleet.",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.10.0 < 21"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "20.14.10",
    "@vitest/coverage-v8": "2.0.4",
    "concurrently": "8.2.2",
    "turbo": "2.0.9",
    "typescript": "5.5.4",
    "vitest": "2.0.4"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "pnpm --filter @horizon/dashboard lint",
    "format:check": "pnpm --filter @horizon/dashboard format:check",
    "stylelint": "pnpm --filter @horizon/dashboard stylelint",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest watch",
    "test:coverage": "pnpm --filter @horizon/dashboard exec vitest run --config vite.config.ts --coverage && pnpm --filter @horizon/server exec vitest run --config vitest.config.ts"
  }
}

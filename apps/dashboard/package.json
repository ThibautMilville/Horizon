{
  "private": true,
  "name": "@horizon/dashboard",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@apollo/client": "3.11.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-date-pickers": "^7.29.4",
    "dayjs": "^1.11.23",
    "graphql": "16.9.0",
    "leaflet": "^1.9.4",
    "material-react-table": "3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "recharts": "3.10.1",
    "satellite.js": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.8.0",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typed-document-node": "5.1.2",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/leaflet": "^1.9.14",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "9.8.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "24.1.1",
    "prettier": "3.3.3",
    "sass": "1.77.8",
    "stylelint": "16.8.2",
    "stylelint-config-standard-scss": "13.1.0",
    "typescript-eslint": "8.0.1",
    "vite": "5.3.4"
  },
  "scripts": {
    "build": "concurrently --kill-others-on-fail --names 'type-check,build' --prefix-colors 'magenta,green' 'tsc --project ./src/tsconfig.test.json' 'vite build'",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "vite",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src --max-warnings=0",
    "start": "vite preview",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "test": "vitest run --config vite.config.ts"
  }
}
